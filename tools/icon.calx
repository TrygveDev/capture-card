// Draws the app icon: a flat dark squircle holding a 16:9 screen with a red "live" dot.
// Run: calx run --release tools/icon.calx -- assets filled   (the shipped icon; "outline" is the alternative)
// Writes assets/icon.png (1024), assets/icon-256.png and assets/icon.ico.

import std.env.{args}
import std.fs.{make_dir_all}
import std.image.{Filter, Image, Kind}

const SIZE: usize = 1024

// Signed distance from (px, py) to a rounded box centred on (cx, cy).
fn rbox(px: f64, py: f64, cx: f64, cy: f64, hw: f64, hh: f64, r: f64) -> f64 {
    let qx = (px - cx).abs() - (hw - r)
    let qy = (py - cy).abs() - (hh - r)
    let ox = qx.max(0.0)
    let oy = qy.max(0.0)
    return (ox * ox + oy * oy).sqrt() + qx.max(qy).min(0.0) - r
}

fn circle(px: f64, py: f64, cx: f64, cy: f64, r: f64) -> f64 {
    let dx = px - cx
    let dy = py - cy
    return (dx * dx + dy * dy).sqrt() - r
}

// Antialiased coverage of a shape from its signed distance, one pixel wide.
fn cover(d: f64) -> f64 {
    return (0.5 - d).max(0.0).min(1.0)
}

fn mix(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

// 0..1 to a byte, rounded and clamped.
fn byte(v: f64) -> u8 {
    return u8.wrap(i32.saturate(v * 255.0 + 0.5).max(0).min(255))
}

fn main() ! Error {
    let a = args()
    let out = if a.len() > 0 { a[0].copy() } else { "assets" }
    let filled = a.len() > 1 and a[1] == "filled"
    try make_dir_all(out)

    let s = f64.nearest(SIZE)
    var px: List<u8> = []
    px.reserve(SIZE * SIZE * 4)

    // Flat colours: near-black background, white screen, red dot.
    let (bgr, bgg, bgb) = (0.075, 0.078, 0.094)
    let (dr, dg, db) = (1.0, 0.231, 0.188)

    // Screen: 16:9, centred.
    let c = s * 0.5
    let shw = s * 0.30
    let shh = shw * 9.0 / 16.0
    let stroke = s * 0.06
    let dot_r = if filled { s * 0.075 } else { s * 0.07 }

    for y in 0usize..SIZE {
        for x in 0usize..SIZE {
            let fx = f64.nearest(x) + 0.5
            let fy = f64.nearest(y) + 0.5
            let bg = cover(rbox(fx, fy, c, c, s * 0.45, s * 0.45, s * 0.22))
            var r = bgr
            var g = bgg
            var b = bgb
            if bg > 0.0 {
                let sd = rbox(fx, fy, c, c, shw, shh, s * 0.075)
                let white = if filled { cover(sd) } else { cover(sd.abs() - stroke * 0.5) }
                r = mix(r, 1.0, white)
                g = mix(g, 1.0, white)
                b = mix(b, 1.0, white)
                let dot = cover(circle(fx, fy, c, c, dot_r))
                r = mix(r, dr, dot)
                g = mix(g, dg, dot)
                b = mix(b, db, dot)
            }
            px.push(byte(r))
            px.push(byte(g))
            px.push(byte(b))
            px.push(byte(bg))
        }
    }

    let big = Image.from_pixels(SIZE, SIZE, Kind.Rgba, px)
    try big.save("{out}/icon.png")
    let small = big.resize(256, 256, Filter.Lanczos)
    try small.save("{out}/icon-256.png")
    try small.save("{out}/icon.ico")
    println("wrote {out}/icon.png, icon-256.png, icon.ico")
}
